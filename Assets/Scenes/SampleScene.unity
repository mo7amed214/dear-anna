  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::PaintingNarration
  interactDistance: 5
  gazeRadius: 0.35
  displayName: 
  narration: The Tsar's Manifesto, the day Petersburg believed it had won. I remember the crowds, the flags, strangers embracing on Nevsky Prospect as if the promise alone had already changed anything. I was not foolish enough to celebrate. A man forced to sign something does not take long to break it.
  displayDuration: 7
  voiceLine: {fileID: 0}
  focusDistance: 1.1
  flatFraming: 1
  focusElevation: 0.35
