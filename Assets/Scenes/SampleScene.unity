  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::PaintingNarration
  interactDistance: 5
  gazeRadius: 0.35
  displayName: The Sentencing
  narration: Nizhny Novgorod, the year before I married Anna. They lined us up and read the sentence, and I remember thinking, quite calmly, that I had never finished the third chapter. Then a rider came with the Tsar's mercy, and I understood for the first time that mercy and cruelty can wear the same coat.
  displayDuration: 7
  voiceLine: {fileID: 0}
  focusDistance: 1.1
  flatFraming: 1
  focusElevation: 0.35
