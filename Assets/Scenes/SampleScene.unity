  interactDistance: 5
  gazeRadius: 0.35
  displayName: 
  narration: Anna's mother, formally posed and unsmiling, exactly as she insisted on being remembered. Anna wouldn't wear her ring the day we buried her -- said grief and joy shouldn't share a hand. I think about that more than I've told her.
  displayDuration: 7
  voiceLine: {fileID: 0}
  focusDistance: 1.1
  flatFraming: 1
  focusElevation: 0.35
